VITE_API_URL=http://localhost:4000
# Supabase project URL, for example https://your-project.supabase.co
VITE_SUPABASE_URL=
# Safe for browser use; use the Supabase dashboard's publishable key.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Public bucket used for the gallery images. Do not put a service-role key here.
VITE_SUPABASE_STORAGE_BUCKET=surprise-media
